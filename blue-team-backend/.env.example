DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Add the exact Netlify website origin, e.g. https://your-team.netlify.app
# Optional shared token for a private demo. Keep empty for local development.
API_TOKEN=
