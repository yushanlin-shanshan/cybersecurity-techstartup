  "components": {
    "schemas": {
      "Ask": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question",
            "default": "Explain this incident"
          },
          "use_llm": {
            "type": "boolean",
            "title": "Use Llm",
            "default": false
          }
        },
        "type": "object",
        "title": "Ask"
      },
      "Batch": {
        "properties": {
          "dataset_name": {
            "type": "string",
            "maxLength": 80,
            "title": "Dataset Name",
            "default": ""
          },
          "allow_llm": {
            "type": "boolean",
            "title": "Allow Llm",
            "default": false
          },
          "scenario": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[\\w-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario"
          },
          "gap_minutes": {
            "type": "number",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Gap Minutes",
            "default": 15
          },
          "max_span_minutes": {
            "type": "number",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Span Minutes",
            "default": 60
          },
          "syslog_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 1970.0,
            "title": "Syslog Year",
            "default": 2022
          },
          "limit": {
            "type": "integer",
            "maximum": 3000000.0,
            "minimum": 0.0,
            "title": "Limit",
            "default": 0
          },
          "filename": {
            "type": "string",
            "maxLength": 150,
            "title": "Filename",
            "default": "custom.jsonl"
          },
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 50000,
            "minItems": 1,
            "title": "Records"
          }
        },
        "type": "object",
        "required": [
          "records"
        ],
        "title": "Batch"
      },
      "Body_upload_api_v1_jobs_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "scenario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario"
          },
          "dataset_name": {
            "type": "string",
            "maxLength": 80,
            "title": "Dataset Name",
            "default": ""
          },
          "allow_llm": {
            "type": "boolean",
            "title": "Allow Llm",
            "default": false
          },
          "gap_minutes": {
            "type": "number",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Gap Minutes",
            "default": 15
          },
          "max_span_minutes": {
            "type": "number",
            "maximum": 1440.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Span Minutes",
            "default": 60
          },
          "syslog_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 1970.0,
            "title": "Syslog Year",
            "default": 2022
          },
          "limit": {
            "type": "integer",
            "maximum": 3000000.0,
            "minimum": 0.0,
            "title": "Limit",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_jobs_post"
      },
      "Feedback": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "new",
              "investigating",
              "resolved",
              "dismissed"
            ],
            "title": "Status"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "unreviewed",
              "suspicious",
              "benign",
              "confirmed"
            ],
            "title": "Disposition"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "status",
          "disposition"
        ],
        "title": "Feedback"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
